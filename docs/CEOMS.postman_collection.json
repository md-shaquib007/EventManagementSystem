{
  "info": {
    "name": "CEOMS API",
    "description": "College Event & Operations Management System API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var json = pm.response.json();",
                "if (json.data && json.data.accessToken) {",
                "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@ceoms.edu\",\n  \"password\": \"Admin@123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"newstudent@ceoms.edu\",\n  \"password\": \"Student@123\",\n  \"firstName\": \"New\",\n  \"lastName\": \"Student\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"your-refresh-token\"\n}" },
            "url": "{{baseUrl}}/auth/refresh"
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List Events",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events?page=0&size=10"
          }
        },
        {
          "name": "Get Event",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/events/1"
          }
        },
        {
          "name": "Create Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Tech Workshop\",\n  \"description\": \"Hands-on coding workshop\",\n  \"categoryId\": 1,\n  \"departmentId\": 1,\n  \"venueId\": 1,\n  \"startDate\": \"2026-08-15\",\n  \"capacity\": 100,\n  \"estimatedBudget\": 50000\n}" },
            "url": "{{baseUrl}}/events"
          }
        },
        {
          "name": "Approve Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"comment\": \"Approved for execution\"\n}" },
            "url": "{{baseUrl}}/events/1/approve"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Admin Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/dashboard/admin"
          }
        }
      ]
    },
    {
      "name": "Master Data",
      "item": [
        {
          "name": "List Departments",
          "request": { "method": "GET", "url": "{{baseUrl}}/departments" }
        },
        {
          "name": "List Categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/categories" }
        },
        {
          "name": "List Venues",
          "request": { "method": "GET", "url": "{{baseUrl}}/venues" }
        }
      ]
    },
    {
      "name": "Operations",
      "item": [
        {
          "name": "Register for Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"eventId\": 1\n}" },
            "url": "{{baseUrl}}/registrations"
          }
        },
        {
          "name": "List Bills",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/bills"
          }
        },
        {
          "name": "Audit Logs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/audit"
          }
        }
      ]
    }
  ]
}
